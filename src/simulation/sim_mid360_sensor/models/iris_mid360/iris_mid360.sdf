<?xml version="1.0"?>
<sdf version="1.7">
  <model name="iris_mid360">
    <include>
      <uri>model://iris</uri>
    </include>

    <link name="mid360_link">
      <!-- Match the real Point-LIO input frame: ROS FLU, x forward, y left, z up. -->
      <pose>0 0 0.13 0 0 0</pose>
      <inertial>
        <mass>0.265</mass>
        <inertia>
          <ixx>0.0003</ixx><iyy>0.0003</iyy><izz>0.0004</izz>
        </inertia>
      </inertial>
      <visual name="housing">
        <geometry><cylinder><radius>0.038</radius><length>0.055</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.14 0.14 0.14 1</diffuse></material>
      </visual>

      <sensor name="mid360_front" type="gpu_ray">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on><visualize>false</visualize><update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal><samples>128</samples><resolution>1</resolution><min_angle>-0.80</min_angle><max_angle>0.80</max_angle></horizontal>
            <vertical><samples>32</samples><resolution>1</resolution><min_angle>-0.122</min_angle><max_angle>0.908</max_angle></vertical>
          </scan>
          <range><min>0.10</min><max>70.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </ray>
        <plugin name="mid360_front_ros" filename="libgazebo_ros_ray_sensor.so">
          <ros><namespace>/sim/mid360</namespace><remapping>~/out:=sector_front</remapping></ros>
          <output_type>sensor_msgs/PointCloud2</output_type><frame_name>mid360_front</frame_name>
        </plugin>
      </sensor>

      <sensor name="mid360_left" type="gpu_ray">
        <pose>0 0 0 0 0 1.57079632679</pose>
        <always_on>true</always_on><visualize>false</visualize><update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal><samples>128</samples><resolution>1</resolution><min_angle>-0.80</min_angle><max_angle>0.80</max_angle></horizontal>
            <vertical><samples>32</samples><resolution>1</resolution><min_angle>-0.122</min_angle><max_angle>0.908</max_angle></vertical>
          </scan>
          <range><min>0.10</min><max>70.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </ray>
        <plugin name="mid360_left_ros" filename="libgazebo_ros_ray_sensor.so">
          <ros><namespace>/sim/mid360</namespace><remapping>~/out:=sector_left</remapping></ros>
          <output_type>sensor_msgs/PointCloud2</output_type><frame_name>mid360_left</frame_name>
        </plugin>
      </sensor>

      <sensor name="mid360_rear" type="gpu_ray">
        <pose>0 0 0 0 0 3.14159265359</pose>
        <always_on>true</always_on><visualize>false</visualize><update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal><samples>128</samples><resolution>1</resolution><min_angle>-0.80</min_angle><max_angle>0.80</max_angle></horizontal>
            <vertical><samples>32</samples><resolution>1</resolution><min_angle>-0.122</min_angle><max_angle>0.908</max_angle></vertical>
          </scan>
          <range><min>0.10</min><max>70.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </ray>
        <plugin name="mid360_rear_ros" filename="libgazebo_ros_ray_sensor.so">
          <ros><namespace>/sim/mid360</namespace><remapping>~/out:=sector_rear</remapping></ros>
          <output_type>sensor_msgs/PointCloud2</output_type><frame_name>mid360_rear</frame_name>
        </plugin>
      </sensor>

      <sensor name="mid360_right" type="gpu_ray">
        <pose>0 0 0 0 0 -1.57079632679</pose>
        <always_on>true</always_on><visualize>false</visualize><update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal><samples>128</samples><resolution>1</resolution><min_angle>-0.80</min_angle><max_angle>0.80</max_angle></horizontal>
            <vertical><samples>32</samples><resolution>1</resolution><min_angle>-0.122</min_angle><max_angle>0.908</max_angle></vertical>
          </scan>
          <range><min>0.10</min><max>70.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </ray>
        <plugin name="mid360_right_ros" filename="libgazebo_ros_ray_sensor.so">
          <ros><namespace>/sim/mid360</namespace><remapping>~/out:=sector_right</remapping></ros>
          <output_type>sensor_msgs/PointCloud2</output_type><frame_name>mid360_right</frame_name>
        </plugin>
      </sensor>

      <sensor name="mid360_imu" type="imu">
        <always_on>true</always_on><visualize>false</visualize><update_rate>200</update_rate>
        <imu>
          <angular_velocity><x><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></x><y><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></y><z><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></z></angular_velocity>
          <linear_acceleration><x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x><y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></y><z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></z></linear_acceleration>
        </imu>
        <plugin name="mid360_imu_ros" filename="libgazebo_ros_imu_sensor.so">
          <ros><namespace>/livox</namespace><remapping>~/out:=imu</remapping></ros>
          <initial_orientation_as_reference>false</initial_orientation_as_reference>
          <frame_name>livox_frame</frame_name>
        </plugin>
      </sensor>
    </link>

    <joint name="mid360_joint" type="fixed">
      <parent>iris::base_link</parent><child>mid360_link</child>
    </joint>
  </model>
</sdf>
