<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bringup_ego_mavros</name>
  <version>0.1.0</version>
  <description>Standalone MAVROS fixed-point/offboard bringup for PX4.</description>

  <maintainer email="noreply@example.com">OpenAI Codex</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>point_lio</exec_depend>

  <test_depend>ament_cmake_test</test_depend>
  <test_depend>python3</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
